         repository it lives in (ESP32-Marauder-Mobile-kiddy) →
         "Marauder Mobile Kiddy". Launchers truncate long labels; the full name is
         what Settings and the app-info screen show. -->
    <string name="app_name">Marauder Mobile Kiddy</string>
    <string name="usb_permission">com.marauder.mobile.kiddy.USB_PERMISSION</string>
</resources>
